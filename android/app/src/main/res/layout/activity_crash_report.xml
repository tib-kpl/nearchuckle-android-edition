<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_crash_report"
                android:textColor="@color/status_red"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_crash_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/crash_report_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_copy_report"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_accent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_copy_crash_report"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_share_report"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_dark"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/btn_share_crash_report"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_clear_report"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/btn_clear_crash_report"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_close_report"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_dark"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/btn_close_report"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Scrollable Log Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:fillViewport="true"
        android:padding="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_crash_log_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textColor="#C8D4E0"
                android:textSize="11sp" />
        </HorizontalScrollView>
    </ScrollView>

</LinearLayout>
